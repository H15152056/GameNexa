/*
 * ============================================================
 * FINAL EXPORTED CHARACTER DATABASE
 * ============================================================
 */

export const genshinCharacters = genshinCharacterData.map((character) => ({
  ...character,

  // Keep both names available so the UI can use either one.
  rarity: character.quality,

  // Safe fallback for any future character without a role.
  role: character.role || 'DPS',

  // Local Vite image
  image: getGenshinImage(character.name),
}))