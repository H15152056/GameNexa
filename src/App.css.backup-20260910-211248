/* Contrast + two-game homepage refinement */
.app { color: var(--text); font-family: Poppins, Arial, Helvetica, sans-serif; }
.navbar { color: var(--text); }
.brand-word { color: #f4fff9; text-shadow: 0 0 18px rgba(40,255,131,.10); }
.brand-word span { color: var(--green); }
.desktop-nav a { color: #d8e8e0; }
.search-button { color: #effff7; }

.hero h1 { color: #f7fffb; text-shadow: 0 8px 35px rgba(0,0,0,.35); }
.hero h1:first-line { color: #f7fffb; }
.hero-description { color: #c5d5ce; }
.hero-description strong { color: #ffffff; }
.hero-stats span { color: #9db0a7; }
.hero-stats strong { color: #ffffff; }

.floating-card {
  min-width: 190px;
  min-height: 58px;
  padding: 0 17px;
  color: #f4fff9;
  background: rgba(3,12,8,.97);
  border: 1px solid rgba(40,255,131,.45);
  box-shadow: 0 16px 45px rgba(0,0,0,.58), 0 0 24px rgba(40,255,131,.08);
}
.floating-card strong { color: #ffffff; font: 700 15px/1 Poppins, sans-serif; }
.floating-icon { filter: drop-shadow(0 0 8px rgba(40,255,131,.25)); }
.card-one { top: 10%; right: 1%; }
.card-two { bottom: 12%; left: 1%; }

.hero-logo-card { background: rgba(2,8,5,.96); border-color: rgba(40,255,131,.48); }

.games-section { padding-top: 46px; }
.games-section .section-heading { margin-bottom: 26px; }
.section-heading h2 { color: #f7fffb; }
.section-counter { color: #9db0a7; }

.games-grid { gap: 24px; }
.game-card {
  position: relative;
  grid-template-columns: 1fr;
  min-height: 500px;
  background: #07110d;
  border: 1px solid rgba(40,255,131,.28);
  box-shadow: 0 22px 65px rgba(0,0,0,.34);
}
.game-card::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  border: 1px solid rgba(255,255,255,.045);
}
.game-card-image {
  min-height: 500px;
  background-position: center;
}
.game-card-shade {
  background: linear-gradient(180deg, rgba(0,0,0,.08) 18%, rgba(2,8,5,.22) 42%, rgba(2,8,5,.96) 100%);
}
.game-card-category {
  top: 22px;
  left: 22px;
  padding: 7px 12px;
  background: rgba(40,255,131,.96);
  box-shadow: 0 8px 25px rgba(40,255,131,.14);
}
.game-card-icon {
  left: auto;
  right: 22px;
  bottom: 24px;
  width: 58px;
  height: 58px;
  background: rgba(3,10,7,.88);
  border-color: rgba(40,255,131,.45);
}
.game-card-info {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 210px;
  padding: 28px 30px 26px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  background: linear-gradient(180deg, transparent 0%, rgba(2,8,5,.55) 12%, rgba(2,8,5,.97) 48%);
}
.game-number { color: var(--green); }
.game-card-info h3 {
  margin: 6px 0 10px;
  color: #ffffff;
  font-size: clamp(34px, 4vw, 48px);
  text-shadow: 0 4px 20px rgba(0,0,0,.7);
}
.game-card-info p { color: #c4d3cc; max-width: 620px; font-size: 13px; }
.game-card-bottom {
  position: static;
  margin-top: 18px;
  padding-top: 14px;
  border-top-color: rgba(255,255,255,.13);
  color: #55ff98;
}
.game-card-bottom strong { color: #ffffff; }

.focus-panel, .latest-guide-card, .cta { color: #f4fff9; }
.focus-panel h2, .cta h2 { color: #f7fffb; }
.focus-list strong { color: #ffffff; }
.focus-list small, .latest-guide-content p, .cta p { color: #b2c2bb; }
.latest-guide-content h3 { color: #ffffff; }
.latest-guide-content span { color: #55ff98; }
footer { color: #e8f5ef; }
footer p, .footer-links a { color: #9fb1a8; }
.footer-copy { color: #73847c; }

@media (max-width: 760px) {
  .floating-card { min-width: 0; }
  .card-one { right: -4px; top: 4%; }
  .card-two { left: -4px; bottom: 7%; }
  .game-card, .game-card-image { min-height: 420px; }
  .game-card-info { min-height: 210px; padding: 24px 22px; }
  .game-card-info p { font-size: 12px; }
}

@media (max-width: 450px) {
  .floating-card { min-height: 52px; padding: 0 12px; }
  .floating-card strong { font-size: 12px; }
  .floating-icon { font-size: 18px; }
  .game-card, .game-card-image { min-height: 390px; }
}


/* Richer game cards */
.game-card-highlights {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 7px;
  margin: 15px 0 14px;
}
.game-card-highlights span {
  min-width: 0;
  padding: 9px 8px;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 9px;
  background: rgba(255,255,255,.035);
  color: var(--text-muted);
  font-size: 8px;
  line-height: 1.25;
  text-transform: uppercase;
  letter-spacing: .04em;
}
.game-card-highlights b {
  display: block;
  margin-bottom: 3px;
  color: #fff;
  font-size: 13px;
  letter-spacing: 0;
}
@media (max-width: 600px) {
  .game-card-highlights {
    grid-template-columns: repeat(3, minmax(0,1fr));
  }
}
